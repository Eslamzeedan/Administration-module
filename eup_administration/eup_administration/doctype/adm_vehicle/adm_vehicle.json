{
  "doctype": "DocType",
  "name": "ADM Vehicle",
  "module": "EuP Administration",
  "custom": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "plate_number",
    "company",
    "branch",
    "make_model",
    "ownership",
    "status",
    "last_odometer",
    "initial_odometer",
    "license_expiry",
    "insurance_expiry",
    "documents",
    "seat_capacity"
  ],
  "fields": [
    {
      "fieldname": "plate_number",
      "label": "Plate Number",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "branch",
      "label": "Branch",
      "fieldtype": "Data"
    },
    {
      "fieldname": "make_model",
      "label": "Make / Model",
      "fieldtype": "Data"
    },
    {
      "fieldname": "ownership",
      "label": "Ownership",
      "fieldtype": "Select",
      "options": "Owned\nLeased",
      "default": "Owned"
    },
    {
      "fieldname": "status",
      "label": "Availability",
      "fieldtype": "Select",
      "options": "Available\nMaintenance\nOut of Service",
      "default": "Available",
      "reqd": 1
    },
    {
      "fieldname": "last_odometer",
      "label": "Last Odometer (km)",
      "fieldtype": "Float",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "initial_odometer",
      "label": "Initial Odometer (km)",
      "fieldtype": "Float",
      "default": "0"
    },
    {
      "fieldname": "license_expiry",
      "label": "License Expiry",
      "fieldtype": "Date"
    },
    {
      "fieldname": "insurance_expiry",
      "label": "Insurance Expiry",
      "fieldtype": "Date"
    },
    {
      "fieldname": "documents",
      "label": "Documents",
      "fieldtype": "Attach"
    },
    {
      "fieldname": "seat_capacity",
      "label": "Passenger Capacity (0 = unspecified)",
      "fieldtype": "Int",
      "default": "0"
    }
  ],
  "permissions": [
    {
      "role": "Administration Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Administration User",
      "read": 1,
      "write": 0,
      "create": 0,
      "report": 1,
      "export": 1
    },
    {
      "role": "Administration Driver",
      "read": 1,
      "write": 0,
      "create": 0,
      "report": 1,
      "export": 1
    }
  ],
  "autoname": "field:plate_number",
  "title_field": "plate_number"
}
