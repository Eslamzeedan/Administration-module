      "label": "company",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "department",
      "options": "Department"
    },
    {
      "fieldname": "requested_by",
      "fieldtype": "Link",
      "label": "requested by",
      "options": "User"
    },
    {
