{
  "doctype": "DocType",
  "name": "ADM SLA Policy",
  "module": "EuP Administration",
  "custom": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "hash",
  "field_order": [
    "request_type",
    "priority",
    "company",
    "response_minutes",
    "resolution_minutes",
    "enabled"
  ],
  "fields": [
    {
      "fieldname": "request_type",
      "fieldtype": "Select",
      "label": "request type",
      "options": "General\nFleet\nMeeting\nRunner\nSupplies\nCustody",
      "reqd": 1
    },
    {
      "fieldname": "priority",
      "fieldtype": "Select",
      "label": "priority",
      "options": "Normal\nUrgent",
      "reqd": 1
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "company",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "response_minutes",
      "fieldtype": "Int",
      "label": "Response Time (Minutes)",
      "reqd": 1
    },
    {
      "fieldname": "resolution_minutes",
      "fieldtype": "Int",
      "label": "Resolution Time (Minutes)",
      "reqd": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "enabled",
      "default": "0"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "Administration Manager",
      "read": 1,
      "create": 1,
      "write": 1
    }
  ]
}
