{
  "doctype": "DocType",
  "name": "ADM Meeting Booking",
  "module": "EuP Administration",
  "custom": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "title",
    "room",
    "organizer",
    "starts_at",
    "ends_at",
    "attendee_count",
    "requirements",
    "meeting_link",
    "status",
    "services",
    "recurrence_root",
    "company"
  ],
  "fields": [
    {
      "fieldname": "title",
      "label": "Meeting Title",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "room",
      "label": "Room",
      "fieldtype": "Link",
      "options": "ADM Meeting Room",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "organizer",
      "label": "Organizer",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "starts_at",
      "label": "Starts At",
      "fieldtype": "Datetime",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "ends_at",
      "label": "Ends At",
      "fieldtype": "Datetime",
      "reqd": 1
    },
    {
      "fieldname": "attendee_count",
      "label": "Attendee Count",
      "fieldtype": "Int",
      "reqd": 1,
      "default": "1"
    },
    {
      "fieldname": "requirements",
      "label": "Hospitality / IT Requirements",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "meeting_link",
      "label": "Online Meeting Link",
      "fieldtype": "Data"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Confirmed\nCompleted\nCancelled",
      "default": "Confirmed",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "services",
      "label": "Services",
      "fieldtype": "Table",
      "options": "ADM Meeting Service"
    },
    {
      "fieldname": "recurrence_root",
      "label": "Recurring Series",
      "fieldtype": "Link",
      "options": "ADM Meeting Booking",
      "read_only": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "Administration Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Administration User",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1
    }
  ],
  "autoname": "format:MEET-{YYYY}-{#####}"
}
