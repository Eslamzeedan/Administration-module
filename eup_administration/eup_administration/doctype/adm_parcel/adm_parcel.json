    {
      "role": "Administration Manager",
      "read": 1,
      "create": 1,
      "write": 1,
      "report": 1
    },
    {
      "role": "Administration User",
      "read": 1,
      "create": 1,
      "write": 1,
      "report": 1
    },
    {
      "role": "Administration Requester",
      "read": 1,
      "create": 1,
      "write": 1,
      "report": 1
    },
    {
      "role": "Administration Coordinator",
      "read": 1,
      "create": 1,
      "write": 1,
      "report": 1
    },
    {
      "role": "Administration Driver",
      "read": 1,
      "create": 1,
      "write": 1,
      "report": 1
    },
    {
      "role": "Administration Runner",
      "read": 1,
      "create": 1,
      "write": 1,
      "report": 1
    },
    {
      "role": "Administration Storekeeper",
      "read": 1,
      "create": 1,
      "write": 1,
      "report": 1
    }
  ]
}
