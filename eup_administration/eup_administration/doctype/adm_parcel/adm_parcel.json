{
  "doctype": "DocType",
  "name": "ADM Parcel",
  "module": "EuP Administration",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "subject",
    "company",
    "department",
    "requested_by",
    "assigned_to",
    "workflow_state",
    "workflow_policy",
    "description",
    "priority",
    "due_at",
    "tracking_number",
    "recipient",
    "sender",
    "received_at",
    "delivered_at",
    "delivery_note",
    "tracking_type",
    "attachment"
  ],
  "fields": [
    {
      "fieldname": "subject",
      "label": "Subject",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "department",
      "label": "Department",
      "fieldtype": "Link",
      "options": "Department"
    },
    {
      "fieldname": "requested_by",
      "label": "Requested By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "assigned_to",
      "label": "Assigned To",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "workflow_state",
      "label": "Workflow State",
      "fieldtype": "Data",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "workflow_policy",
      "label": "Workflow Policy",
      "fieldtype": "Link",
      "options": "ADM Workflow Policy",
      "read_only": 1
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "Low\nNormal\nHigh\nCritical",
      "default": "Normal"
    },
    {
      "fieldname": "due_at",
      "label": "Due At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "tracking_number",
      "label": "Tracking Number",
      "fieldtype": "Data",
      "unique": 1,
      "reqd": 1
    },
    {
      "fieldname": "recipient",
      "label": "Recipient",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "sender",
      "label": "Sender",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "received_at",
      "label": "Received At",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "delivered_at",
      "label": "Delivered At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "delivery_note",
      "label": "Delivery Note",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "tracking_type",
      "label": "Tracking Type",
      "fieldtype": "Select",
      "options": "Parcel\nInternal Document",
      "default": "Parcel",
      "reqd": 1
    },
    {
      "fieldname": "attachment",
      "label": "Attachment",
      "fieldtype": "Attach"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
