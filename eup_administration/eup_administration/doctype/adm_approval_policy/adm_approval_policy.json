{
  "doctype": "DocType",
  "name": "ADM Approval Policy",
  "module": "EuP Administration",
  "custom": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "hash",
  "field_order": [
    "policy_name",
    "request_type",
    "company",
    "enabled",
    "steps",
    "description"
  ],
  "fields": [
    {
      "fieldname": "policy_name",
      "fieldtype": "Data",
      "label": "policy name",
      "reqd": 1
    },
    {
      "fieldname": "request_type",
      "fieldtype": "Select",
      "label": "request type",
      "options": "General\nFleet\nMeeting\nRunner\nSupplies\nCustody",
      "reqd": 1
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "company",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "enabled",
      "default": "0"
    },
    {
      "fieldname": "steps",
      "fieldtype": "Table",
      "label": "Approval Steps",
      "options": "ADM Approval Step"
    },
    {
      "fieldname": "description",
      "fieldtype": "Data",
      "label": "description"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "Administration Manager",
      "read": 1,
      "create": 1,
      "write": 1
    }
  ]
}
