{
  "doctype": "DocType",
  "name": "ADM Maintenance",
  "module": "EuP Administration",
  "custom": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "format:ADM_MAINTENANCE-{YYYY}-{#####}",
  "field_order": [
    "vehicle",
    "company",
    "subject",
    "starts_at",
    "ends_at",
    "status",
    "currency",
    "cost",
    "odometer",
    "next_due_date",
    "next_due_odometer",
    "completed_at",
    "notes"
  ],
  "fields": [
    {
      "fieldname": "vehicle",
      "label": "Vehicle",
      "fieldtype": "Link",
      "options": "ADM Vehicle",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "read_only": 1
    },
    {
      "fieldname": "subject",
      "label": "Work Required",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "starts_at",
      "label": "Planned Start",
      "fieldtype": "Datetime",
      "reqd": 1
    },
    {
      "fieldname": "ends_at",
      "label": "Planned End",
      "fieldtype": "Datetime",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Scheduled\nIn Progress\nCompleted\nCancelled",
      "default": "Scheduled",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Link",
      "options": "Currency",
      "read_only": 1
    },
    {
      "fieldname": "cost",
      "label": "Cost",
      "fieldtype": "Currency",
      "options": "currency"
    },
    {
      "fieldname": "odometer",
      "label": "Odometer at Completion",
      "fieldtype": "Float"
    },
    {
      "fieldname": "next_due_date",
      "label": "Next Due Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "next_due_odometer",
      "label": "Next Due Odometer",
      "fieldtype": "Float"
    },
    {
      "fieldname": "completed_at",
      "label": "Completed At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "notes",
      "label": "Work Details",
      "fieldtype": "Small Text"
    }
  ],
  "permissions": [
    {
      "role": "Administration Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "submit": 1,
      "cancel": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "submit": 1,
      "cancel": 1
    }
  ]
}
